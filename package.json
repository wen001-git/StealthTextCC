{
  "name": "stealthtextcc",
  "version": "0.1.0",
  "description": "macOS / Windows 隐身浮层提词器：永远置顶，录屏时不可见（与 StealthText 区分）",
  "main": "main.js",
  "author": "stealthtextcc",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/screen-protection.test.mjs",
    "build:mac": "electron-builder --mac dir --arm64",
    "build:mac:x64": "electron-builder --mac dir --x64",
    "build:mac:universal": "npm run build:mac && npm run build:mac:x64",
    "build:win": "electron-builder --win zip --x64",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.stealthtextcc.app",
    "productName": "StealthTextCC",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": null,
      "artifactName": "StealthTextCC-${version}-${arch}.${ext}"
    }
  }
}
